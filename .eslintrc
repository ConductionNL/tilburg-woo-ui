{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:import/recommended"
  ],
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 2021,
    "sourceType": "module",
    "babelOptions": {
      "plugins": [
        ["@babel/plugin-proposal-decorators", { "legacy": true }],
        ["@babel/plugin-proposal-class-properties", { "loose": true }]
      ]
    }
  },
  "plugins": ["react", "react-hooks", "import"],
  "rules": {
    // Import regels - deze zouden de useNavigate fout hebben gevangen
    "import/no-unresolved": "error",
    "import/named": "error",
    "import/default": "error",
    "import/namespace": "error",
    "import/no-absolute-path": "error",

    // React regels
    "react/prop-types": "off", // Project gebruikt geen PropTypes
    "react/react-in-jsx-scope": "off", // Niet nodig in moderne React

    // React Hooks regels
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "off",

    // Algemene regels
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-console": "warn",
    "no-debugger": "error"
  },
  "settings": {
    "react": {
      "version": "detect"
    },
    "import/resolver": {
      "alias": {
        "map": [
          ["@src", "./src"],
          ["@assets", "./src/assets"],
          ["@fonts", "./src/assets/fonts"],
          ["@data", "./src/assets/data"],
          ["@styles", "./src/styles"],
          ["@atoms", "./src/atoms"],
          ["@components", "./src/components"],
          ["@models", "./src/models"],
          ["@molecules", "./src/molecules"],
          ["@tabs", "./src/tabs"],
          ["@views", "./src/views"],
          ["@api", "./src/api"],
          ["@config", "./src/config"],
          ["@constants", "./src/constants"],
          ["@hooks", "./src/hooks"],
          ["@services", "./src/services"],
          ["@stores", "./src/stores"],
          ["@utils", "./src/utilities"]
        ],
        "extensions": [".js", ".jsx"]
      },
      "node": {
        "extensions": [".js", ".jsx", ".ts", ".tsx"]
      }
    }
  }
}
