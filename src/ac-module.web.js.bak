// Imports => React
import React from "react";
import { inject, observer } from 'mobx-react-lite';

// Imports => Controller
import AcModuleController from './ac-module.controller.js';

@inject('store')
@observer
class AcModule extends AcModuleController {
    render() {
        return <div className={this.getStyleClassNames()} />;
    }
}

export default AcModule;