// Imports => React
import React from "react";
import PropTypes from "prop-types";
import clsx from "clsx";

const _CLASSES = {
    MAIN: 'ac-module'
};

class AcModuleController extends React.Component {
    constructor(props) {
        super(props);

        this.store = props.store;

        this.state = {};
    }

    getStyleClassNames() {
        return clsx(_CLASSES.MAIN);
    }
}

AcModuleController.propTypes = {};

AcModuleController.defaultProps = {};

export default AcModuleController;