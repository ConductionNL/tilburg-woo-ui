{
	"compilerOptions": {
		"experimentalDecorators": true,
		"baseUrl": "./",
		"paths": {
			"@src/*": ["src/*"],
			"@assets/*": ["src/assets/*"],
			"@fonts/*": ["src/assets/fonts/*"],
			"@data/*": ["src/assets/data/*"],
			"@styles/*": ["src/styles/*"],
			"@atoms/*": ["src/atoms/*"],
			"@components/*": ["src/components/*"],
			"@models/*": ["src/models/*"],
			"@molecules/*": ["src/molecules/*"],
			"@tabs/*": ["src/tabs/*"],
			"@views/*": ["src/views/*"],
			"@api/*": ["src/api/*"],
			"@config/*": ["src/config/*"],
			"@constants/*": ["src/constants/*"],
			"@hooks/*": ["src/hooks/*"],
			"@services/*": ["src/services/*"],
			"@stores/*": ["src/stores/*"],
			"@utils/*": ["src/utilities"],
			"@src": ["src/index"],
			"@assets": ["src/assets/index"],
			"@fonts": ["src/assets/fonts/index"],
			"@data": ["src/assets/data/index"],
			"@styles": ["src/styles/index"],
			"@atoms": ["src/atoms/index"],
			"@components": ["src/components/index"],
			"@models": ["src/models/index"],
			"@molecules": ["src/molecules/index"],
			"@tabs": ["src/tabs/index"],
			"@views": ["src/views/index"],
			"@api": ["src/api/index"],
			"@config": ["src/config/index"],
			"@constants": ["src/constants/index"],
			"@hooks": ["src/hooks/index"],
			"@services": ["src/services/index"],
			"@stores": ["src/stores/index"],
			"@utils": ["src/utilities/index"],
			"@nlds": ["~/node_modules"] // add path to NLDS package here
		}
	}
}
