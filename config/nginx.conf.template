user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log;
    sendfile on;
    keepalive_timeout 65;
    
    # Enable gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    server {
        listen 81;
        root ${NGINX_ROOT_DIR};
        index index.html;

        # Security headers
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header X-XSS-Protection "1; mode=block" always;

        # API Proxy for Nextcloud apps (adds index.php automatically)
        location /api/apps/ {
            proxy_pass ${NGINX_NEXTCLOUD_UPSTREAM}/index.php/apps/;
            proxy_set_header Host ${NGINX_TARGET_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cookie_path / /;
            proxy_cookie_domain ${NGINX_NEXTCLOUD_DOMAIN} $host;
            
            # CORS headers removed - let the backend (OpenConnector) handle CORS
            # This prevents duplicate headers which cause CORS failures
        }

        # Static file serving with SPA routing
        location / {
            try_files $uri $uri/ /index.html;
        }

        # Cache static assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1h;
            add_header Cache-Control "public, immutable";
        }
    }
} 