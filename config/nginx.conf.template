user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log;
    sendfile on;
    keepalive_timeout 65;
    
    # Enable gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Serve the .gz files produced at build time by compression-webpack-plugin
    # instead of re-compressing every response. Without this the pre-compressed
    # assets shipped in the image were never used, and nginx spent CPU gzipping
    # the same bytes on every request at a lower compression level.
    gzip_static on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;

    server {
        listen 81;
        root ${NGINX_ROOT_DIR};
        index index.html;

        # Security headers
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header X-XSS-Protection "1; mode=block" always;

        # API Proxy for Nextcloud apps (adds index.php automatically)
        location /api/apps/ {
            proxy_pass ${NGINX_NEXTCLOUD_UPSTREAM}/index.php/apps/;
            proxy_set_header Host ${NGINX_TARGET_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cookie_path / /;
            
            # Hide any CORS headers from backend to prevent conflicts
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Methods;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Max-Age;
            
            # Override with correct CORS headers based on requesting origin
            add_header Access-Control-Allow-Origin $http_origin always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin, Cache-Control, Pragma" always;
            add_header Access-Control-Max-Age 86400 always;
            
            # Handle preflight OPTIONS requests
            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin $http_origin always;
                add_header Access-Control-Allow-Credentials true always;
                add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS" always;
                add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin, Cache-Control, Pragma" always;
                add_header Access-Control-Max-Age 86400 always;
                add_header Content-Type "text/plain charset=UTF-8" always;
                add_header Content-Length 0 always;
                return 204;
            }
        }

        # NOTE ON add_header INHERITANCE
        # A location block that sets any add_header of its own discards every
        # add_header inherited from the server block — they do not merge. The
        # security headers above therefore have to be repeated in each location
        # below, otherwise they silently vanish from exactly the responses that
        # carry executable content.

        # index.html is the only file that names the content-hashed bundles, so
        # it must be revalidated on every load. Left uncached it picks up the
        # browser's heuristic freshness instead, which keeps returning visitors
        # pointed at chunk filenames that no longer exist after a deploy.
        location = /index.html {
            add_header Cache-Control "no-cache, must-revalidate" always;
            add_header X-Content-Type-Options nosniff always;
            add_header X-Frame-Options DENY always;
            add_header X-XSS-Protection "1; mode=block" always;
        }

        # Static file serving with SPA routing
        location / {
            try_files $uri $uri/ /index.html;
        }

        # Everything under /static/ carries a content hash in its filename, so a
        # change always produces a new URL and the old one can be kept for a
        # year. Cache-Control is set once, by hand: pairing `expires` with an
        # `add_header Cache-Control` emits two contradictory headers, which is
        # how this previously ended up advertising both max-age=3600 and
        # immutable on the same response.
        location /static/ {
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            add_header X-Content-Type-Options nosniff always;
            add_header X-Frame-Options DENY always;
            add_header X-XSS-Protection "1; mode=block" always;
        }

        # Unhashed assets at the root (favicon, manifest, icons). Their URL does
        # not change when the file does, so they have to be revalidated.
        location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webmanifest)$ {
            add_header Cache-Control "public, max-age=3600, must-revalidate" always;
            add_header X-Content-Type-Options nosniff always;
            add_header X-Frame-Options DENY always;
            add_header X-XSS-Protection "1; mode=block" always;
        }
    }
} 