# Development Dockerfile for React application with watch builds
FROM node:18.17.0-alpine as base

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache git curl

# Enable Corepack for Yarn 4
RUN corepack enable

# Copy package files
COPY package.json yarn.lock .yarnrc.yml ./

# Set Yarn version
RUN yarn set version 4.1.1

# Install dependencies
RUN yarn install --immutable

# Copy source code
COPY . .

# Development stage with watch build + nginx (Port 81)
FROM base as development

# Install nginx
RUN apk add --no-cache nginx

# Create nginx directories
RUN mkdir -p /var/log/nginx /var/lib/nginx/tmp /etc/nginx/conf.d

# Create nginx config for development
RUN echo 'server {' > /etc/nginx/conf.d/default.conf && \
    echo '    listen 81;' >> /etc/nginx/conf.d/default.conf && \
    echo '    root /app/public_html;' >> /etc/nginx/conf.d/default.conf && \
    echo '    index index.html;' >> /etc/nginx/conf.d/default.conf && \
    echo '    location / {' >> /etc/nginx/conf.d/default.conf && \
    echo '        try_files $uri $uri/ /index.html;' >> /etc/nginx/conf.d/default.conf && \
    echo '    }' >> /etc/nginx/conf.d/default.conf && \
    echo '    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {' >> /etc/nginx/conf.d/default.conf && \
    echo '        expires 1h;' >> /etc/nginx/conf.d/default.conf && \
    echo '        add_header Cache-Control "public, immutable";' >> /etc/nginx/conf.d/default.conf && \
    echo '    }' >> /etc/nginx/conf.d/default.conf && \
    echo '}' >> /etc/nginx/conf.d/default.conf

# Update main nginx config
RUN echo 'user nginx;' > /etc/nginx/nginx.conf && \
    echo 'worker_processes auto;' >> /etc/nginx/nginx.conf && \
    echo 'error_log /var/log/nginx/error.log notice;' >> /etc/nginx/nginx.conf && \
    echo 'pid /var/run/nginx.pid;' >> /etc/nginx/nginx.conf && \
    echo 'events { worker_connections 1024; }' >> /etc/nginx/nginx.conf && \
    echo 'http {' >> /etc/nginx/nginx.conf && \
    echo '    include /etc/nginx/mime.types;' >> /etc/nginx/nginx.conf && \
    echo '    default_type application/octet-stream;' >> /etc/nginx/nginx.conf && \
    echo '    access_log /var/log/nginx/access.log;' >> /etc/nginx/nginx.conf && \
    echo '    sendfile on;' >> /etc/nginx/nginx.conf && \
    echo '    keepalive_timeout 65;' >> /etc/nginx/nginx.conf && \
    echo '    include /etc/nginx/conf.d/*.conf;' >> /etc/nginx/nginx.conf && \
    echo '}' >> /etc/nginx/nginx.conf

# Create startup script
RUN echo '#!/bin/sh' > /start-dev.sh && \
    echo 'echo "Starting development mode with watch build..."' >> /start-dev.sh && \
    echo '# Generate container constants from environment variables' >> /start-dev.sh && \
    echo 'echo "🔧 Generating container constants..."' >> /start-dev.sh && \
    echo 'node scripts/generate-container-constants.js' >> /start-dev.sh && \
    echo '# Initial build' >> /start-dev.sh && \
    echo 'echo "🏗️ Running initial build..."' >> /start-dev.sh && \
    echo 'yarn build:web' >> /start-dev.sh && \
    echo '# Start nginx in background' >> /start-dev.sh && \
    echo 'echo "🚀 Starting nginx server..."' >> /start-dev.sh && \
    echo 'nginx -g "daemon off;" &' >> /start-dev.sh && \
    echo '# Watch for changes and rebuild' >> /start-dev.sh && \
    echo 'echo "👀 Starting file watcher..."' >> /start-dev.sh && \
    echo 'while true; do' >> /start-dev.sh && \
    echo '  inotifywait -r -e modify,move,create,delete src/ public/ config/ --quiet' >> /start-dev.sh && \
    echo '  echo "📝 Files changed, regenerating constants..."' >> /start-dev.sh && \
    echo '  node scripts/generate-container-constants.js' >> /start-dev.sh && \
    echo '  echo "🔄 Rebuilding..."' >> /start-dev.sh && \
    echo '  yarn build:web' >> /start-dev.sh && \
    echo '  echo "✅ Build complete at $(date)"' >> /start-dev.sh && \
    echo 'done' >> /start-dev.sh && \
    chmod +x /start-dev.sh

# Install inotify for file watching
RUN apk add --no-cache inotify-tools

# Expose port 81
EXPOSE 81

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:81/ || exit 1

# Start watch build + nginx
CMD ["/start-dev.sh"]

# Hot reload stage (Port 3000)
FROM base as hot-reload

# Expose port 3000 for hot reload
EXPOSE 3000

# Health check for hot reload
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Start development server with hot reload
CMD ["yarn", "start"] 